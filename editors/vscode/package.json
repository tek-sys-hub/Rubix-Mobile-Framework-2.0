{
  "name": "rubix-language",
  "displayName": "Rubix Programming Language",
  "description": "Official IDE language support for the Rubix programming language (*.bix)",
  "version": "1.0.0",
  "publisher": "Rubix-lang-v10",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tek-sys-hub/Rubix-Mobile-Framework-2.0"
  },
  "icon": "icons/rubix-logo.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:rubix"
  ],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "rubix",
    "bix",
    "systems",
    "compiler",
    "aot",
    "performance"
  ],
  "contributes": {
    "languages": [
      {
        "id": "rubix",
        "aliases": [
          "Rubix",
          "rubix",
          "bix"
        ],
        "extensions": [
          ".bix"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/rubix-icon.png",
          "dark": "./icons/rubix-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "rubix",
        "scopeName": "source.rubix",
        "path": "./syntaxes/rubix.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rubix",
        "path": "./snippets/rubix.json"
      }
    ],
    "commands": [
      {
        "command": "rubix.run",
        "title": "Rubix: Run Active File",
        "icon": "$(play)"
      },
      {
        "command": "rubix.build",
        "title": "Rubix: Build Standalone Native Executable",
        "icon": "$(package)"
      },
      {
        "command": "rubix.check",
        "title": "Rubix: Check Diagnostics & Types",
        "icon": "$(check)"
      },
      {
        "command": "rubix.format",
        "title": "Rubix: Format Document",
        "icon": "$(symbol-class)"
      },
      {
        "command": "rubix.doctor",
        "title": "Rubix: Run Doctor Subsystem Health Check",
        "icon": "$(pulse)"
      },
      {
        "command": "rubix.init",
        "title": "Rubix: Initialize New Project",
        "icon": "$(new-folder)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "rubix.run",
          "when": "editorLangId == rubix",
          "group": "navigation@1"
        },
        {
          "command": "rubix.build",
          "when": "editorLangId == rubix",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "rubix.run",
          "when": "editorLangId == rubix",
          "group": "1_modification@1"
        },
        {
          "command": "rubix.build",
          "when": "editorLangId == rubix",
          "group": "1_modification@2"
        },
        {
          "command": "rubix.check",
          "when": "editorLangId == rubix",
          "group": "1_modification@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "rubix.run",
        "key": "ctrl+shift+r",
        "when": "editorLangId == rubix && editorTextFocus"
      },
      {
        "command": "rubix.build",
        "key": "ctrl+shift+b",
        "when": "editorLangId == rubix && editorTextFocus"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Rubix Configuration",
      "properties": {
        "rubix.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run rubix check diagnostics on document save."
        },
        "rubix.formatOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run rubix fmt on document save."
        }
      }
    }
  }
}
